file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}/source")
file(WRITE "${WORK_DIR}/source/value.c" "int value(void) { return 42; }\n")
file(WRITE "${WORK_DIR}/source/main.c"
  "int value(void); int main(void) { return value() != 42; }\n")
file(WRITE "${WORK_DIR}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
project(ProjectCommandWrappers C)
# Match Ceph's BuildBoost.cmake: wrap the commands after the IR plugin loads.
function(add_library target)
  _add_library(${target} ${ARGN})
  if(NOT ";${ARGN};" MATCHES ";(ALIAS|IMPORTED);")
    set_property(TARGET "${target}" PROPERTY PROJECT_WRAPPER_CALLED TRUE)
  endif()
endfunction()
function(add_executable target)
  _add_executable(${target} ${ARGN})
  set_property(TARGET "${target}" PROPERTY PROJECT_WRAPPER_CALLED TRUE)
endfunction()
function(install)
  _install(${ARGV})
endfunction()
macro(build_boost version)
  add_library(Boost::atomic STATIC IMPORTED)
  add_library(Boost::headers INTERFACE IMPORTED)
endmacro()
build_boost(1.87)
add_library(value STATIC value.c)
add_library(value_alias ALIAS value)
add_executable(app main.c)
target_link_libraries(app PRIVATE value_alias)
foreach(target IN ITEMS value app)
  get_target_property(called "${target}" PROJECT_WRAPPER_CALLED)
  if(NOT called)
    message(FATAL_ERROR "Project wrapper was bypassed for ${target}")
  endif()
endforeach()
install(TARGETS value app ARCHIVE DESTINATION lib RUNTIME DESTINATION bin)
]=])
execute_process(
  COMMAND "${CMAKE_COMMAND}" -E env CMAKE_EMIT_LLVMIR=1
    "${CMAKE_COMMAND}" -S "${WORK_DIR}/source" -B "${WORK_DIR}/build" -G Ninja
    -DCMAKE_C_COMPILER=clang "-DCMAKE_PROJECT_INCLUDE=${MODULE_FILE}"
  RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error
)
if(NOT _result EQUAL 0)
  message(FATAL_ERROR "Project wrapper configure failed: ${_output}\n${_error}")
endif()
foreach(_args IN ITEMS build install)
  if(_args STREQUAL "build")
    set(_command --build "${WORK_DIR}/build")
  else()
    set(_command --install "${WORK_DIR}/build" --prefix "${WORK_DIR}/install")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" ${_command}
    RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
  if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Project wrapper ${_args} failed: ${_output}\n${_error}")
  endif()
endforeach()
foreach(_file IN ITEMS bin/app lib/libvalue.a lib/llvmir-bin/app.bc lib/llvmir/libvalue.a)
  if(NOT EXISTS "${WORK_DIR}/install/${_file}")
    message(FATAL_ERROR "Missing installed output: ${_file}")
  endif()
endforeach()
execute_process(COMMAND "${WORK_DIR}/install/bin/app" RESULT_VARIABLE _result)
if(NOT _result EQUAL 0)
  message(FATAL_ERROR "Installed executable returned ${_result}")
endif()