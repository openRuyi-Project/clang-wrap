# Expand Clang/GNU-style response files using CMake's UNIX_COMMAND tokenizer.
# Response paths are resolved relative to the file that references them.

function(_cmake_emit_llvmir_validate_response_content content response_file)
  string(LENGTH "${content}" _length)
  set(_index 0)
  set(_single_quote FALSE)
  set(_double_quote FALSE)
  while(_index LESS _length)
    string(SUBSTRING "${content}" ${_index} 1 _character)
    if(_character STREQUAL "\\")
      math(EXPR _index "${_index} + 1")
    elseif(_character STREQUAL "'" AND NOT _double_quote)
      if(_single_quote)
        set(_single_quote FALSE)
      else()
        set(_single_quote TRUE)
      endif()
    elseif(_character STREQUAL "\"" AND NOT _single_quote)
      if(_double_quote)
        set(_double_quote FALSE)
      else()
        set(_double_quote TRUE)
      endif()
    endif()
    math(EXPR _index "${_index} + 1")
  endwhile()
  if(_single_quote OR _double_quote)
    message(FATAL_ERROR "Response file has an unterminated quote: ${response_file}")
  endif()
endfunction()

function(_cmake_emit_llvmir_expand_response_arguments_impl result base_dir depth active_files)
  if(depth GREATER 32)
    message(FATAL_ERROR "Response-file nesting exceeds 32 levels.")
  endif()

  set(_result "")
  foreach(_argument IN LISTS ARGN)
    if(_argument MATCHES "^@@")
      string(SUBSTRING "${_argument}" 1 -1 _literal_argument)
      list(APPEND _result "${_literal_argument}")
    elseif(_argument MATCHES "^@(.+)$")
      set(_response_path "${CMAKE_MATCH_1}")
      if(IS_ABSOLUTE "${_response_path}")
        set(_response_file "${_response_path}")
      else()
        set(_response_file "${base_dir}/${_response_path}")
      endif()
      if(NOT EXISTS "${_response_file}")
        message(FATAL_ERROR "Response file does not exist: ${_response_file}")
      endif()
      file(REAL_PATH "${_response_file}" _response_file)
      list(FIND active_files "${_response_file}" _cycle_index)
      if(NOT _cycle_index EQUAL -1)
        message(FATAL_ERROR "Response-file inclusion cycle detected at ${_response_file}.")
      endif()
      file(READ "${_response_file}" _response_content)
      _cmake_emit_llvmir_validate_response_content("${_response_content}" "${_response_file}")
      separate_arguments(_response_arguments UNIX_COMMAND "${_response_content}")
      get_filename_component(_response_dir "${_response_file}" DIRECTORY)
      math(EXPR _next_depth "${depth} + 1")
      set(_next_active_files "${active_files};${_response_file}")
      _cmake_emit_llvmir_expand_response_arguments_impl(
        _nested_arguments "${_response_dir}" "${_next_depth}" "${_next_active_files}"
        ${_response_arguments})
      list(APPEND _result ${_nested_arguments})
    else()
      list(APPEND _result "${_argument}")
    endif()
  endforeach()
  set(${result} "${_result}" PARENT_SCOPE)
endfunction()

function(cmake_emit_llvmir_expand_response_arguments result base_dir)
  _cmake_emit_llvmir_expand_response_arguments_impl(
    _expanded_arguments "${base_dir}" 0 "" ${ARGN})
  set(${result} "${_expanded_arguments}" PARENT_SCOPE)
endfunction()