if(NOT DEFINED COMPILE_DATABASE OR NOT DEFINED TARGET_NAME OR
   NOT DEFINED SOURCE_PATH OR NOT DEFINED BC_OUTPUT)
  message(FATAL_ERROR "COMPILE_DATABASE, TARGET_NAME, SOURCE_PATH, and BC_OUTPUT are required.")
endif()

if(NOT EXISTS "${COMPILE_DATABASE}")
  message(FATAL_ERROR "Compilation database not found: ${COMPILE_DATABASE}")
endif()

file(READ "${COMPILE_DATABASE}" _database)
string(JSON _entry_count LENGTH "${_database}")
if(_entry_count EQUAL 0)
  message(FATAL_ERROR "Compilation database is empty: ${COMPILE_DATABASE}")
endif()
set(_selected_command "")
set(_fallback_command "")
set(_matching_command_count 0)
set(_target_marker "CMakeFiles/${TARGET_NAME}.dir/")
get_filename_component(_source_name "${SOURCE_PATH}" NAME)
file(REAL_PATH "${SOURCE_PATH}" _normalized_source_path)

math(EXPR _last_index "${_entry_count} - 1")
foreach(_index RANGE 0 ${_last_index})
  string(JSON _file GET "${_database}" ${_index} file)
  if(NOT EXISTS "${_file}")
    continue()
  endif()
  file(REAL_PATH "${_file}" _normalized_file_path)
  if(NOT "${_normalized_file_path}" STREQUAL "${_normalized_source_path}")
    continue()
  endif()
  math(EXPR _matching_command_count "${_matching_command_count} + 1")

  string(JSON _command GET "${_database}" ${_index} command)
  string(JSON _directory GET "${_database}" ${_index} directory)
  if(_fallback_command STREQUAL "")
    set(_fallback_command "${_command}")
    set(_fallback_directory "${_directory}")
  endif()
  string(JSON _output ERROR_VARIABLE _output_error GET "${_database}" ${_index} output)
  string(FIND "${_output}" "${_target_marker}" _target_marker_index)
  if(NOT _output_error AND NOT _target_marker_index EQUAL -1)
    set(_selected_command "${_command}")
    set(_selected_directory "${_directory}")
    break()
  endif()
endforeach()

# A generated file can share its relative name with a pre-generated source
# fallback. CMake may expose the latter in a target's SOURCES property while
# compile_commands.json correctly records the binary-tree output. Use a name
# fallback only when exactly one command for this target can own it.
if(_selected_command STREQUAL "" AND _matching_command_count EQUAL 0)
  set(_name_fallback_command "")
  set(_name_fallback_directory "")
  set(_name_fallback_count 0)
  foreach(_index RANGE 0 ${_last_index})
    string(JSON _file GET "${_database}" ${_index} file)
    get_filename_component(_file_name "${_file}" NAME)
    if(NOT _file_name STREQUAL _source_name)
      continue()
    endif()
    string(JSON _output ERROR_VARIABLE _output_error GET "${_database}" ${_index} output)
    string(FIND "${_output}" "${_target_marker}" _target_marker_index)
    if(_output_error OR _target_marker_index EQUAL -1)
      continue()
    endif()
    math(EXPR _name_fallback_count "${_name_fallback_count} + 1")
    string(JSON _name_fallback_command GET "${_database}" ${_index} command)
    string(JSON _name_fallback_directory GET "${_database}" ${_index} directory)
  endforeach()
  if(_name_fallback_count EQUAL 1)
    set(_selected_command "${_name_fallback_command}")
    set(_selected_directory "${_name_fallback_directory}")
  elseif(_name_fallback_count GREATER 1)
    message(FATAL_ERROR "Multiple compile commands for target '${TARGET_NAME}' share generated source name '${_source_name}'.")
  endif()
endif()

if(_selected_command STREQUAL "")
  if(_matching_command_count EQUAL 1)
    set(_selected_command "${_fallback_command}")
    set(_selected_directory "${_fallback_directory}")
  elseif(_matching_command_count GREATER 1)
    message(FATAL_ERROR "Multiple compile commands match source '${SOURCE_PATH}', but none can be associated with target '${TARGET_NAME}'.")
  endif()
endif()
if(_selected_command STREQUAL "")
  message(FATAL_ERROR "No compile command for target '${TARGET_NAME}' and source '${SOURCE_PATH}'.")
endif()
if(NOT DEFINED _selected_directory)
  set(_selected_directory "${CMAKE_CURRENT_BINARY_DIR}")
endif()

separate_arguments(_command UNIX_COMMAND "${_selected_command}")
set(_bitcode_command "")
set(_skip_next FALSE)
foreach(_argument IN LISTS _command)
  if(_skip_next)
    set(_skip_next FALSE)
  elseif(_argument STREQUAL "-o")
    set(_skip_next TRUE)
  elseif(_argument MATCHES "^-o.+")
    # Drop the native object output; a new .bc output is appended below.
  elseif(_argument STREQUAL "-emit-llvm" OR _argument STREQUAL "-fno-discard-value-names")
    # Avoid duplicate LLVM-specific options.
  else()
    list(APPEND _bitcode_command "${_argument}")
  endif()
endforeach()

if(DEFINED EXTRA_FLAGS_FILE AND EXISTS "${EXTRA_FLAGS_FILE}")
  file(READ "${EXTRA_FLAGS_FILE}" _extra_flags)
  string(STRIP "${_extra_flags}" _extra_flags)
  if(NOT _extra_flags STREQUAL "")
    separate_arguments(_extra_arguments UNIX_COMMAND "${_extra_flags}")
    list(APPEND _bitcode_command ${_extra_arguments})
  endif()
endif()

get_filename_component(_bc_directory "${BC_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_bc_directory}")
list(APPEND _bitcode_command "-emit-llvm" "-fno-discard-value-names" "-o" "${BC_OUTPUT}")
execute_process(
  COMMAND ${_bitcode_command}
  WORKING_DIRECTORY "${_selected_directory}"
  RESULT_VARIABLE _result
)
if(NOT _result EQUAL 0)
  message(FATAL_ERROR "Failed to emit bitcode for '${SOURCE_PATH}'.")
endif()